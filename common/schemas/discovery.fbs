namespace meminfo.discovery;

table Announcement {
  protocol_version: uint16;
  node_id: [ubyte];          // 16 bytes UUID
  hostname: string;
  free_ram_bytes: uint64;
  free_vram_bytes: uint64;   // 0 if no GPU
  heartbeat_ts: uint64;      // unix epoch ms
  memory_port: uint16;       // memoryd listening port
  gpu_port: uint16;          // gpud listening port (0 if none)
  listen_address: string;    // IP address for data connections
}

root_type Announcement;
