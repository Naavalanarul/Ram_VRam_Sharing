namespace meminfo.control;

enum ControlCommand : uint8 {
  LIST_PEERS = 0,
  GET_LOCAL_STATUS = 1,
  JOIN_POOL = 2,
  LEAVE_POOL = 3,
  // Asked of memoryd's control socket rather than discoveryd's: reports the
  // daemon's real pool occupancy so capacity announcements describe the pool
  // that allocations actually come out of, not raw OS free RAM.
  GET_MEMORY_STATS = 4
}

enum PeerState : uint8 {
  ACTIVE = 0,
  STALE = 1
}

table PeerInfo {
  node_id: [ubyte];          // 16 bytes UUID
  hostname: string;
  address: string;
  free_ram_bytes: uint64;
  free_vram_bytes: uint64;
  memory_port: uint16;
  gpu_port: uint16;
  state: PeerState;
  last_seen_ms: uint64;      // unix epoch ms
}

table ControlRequest {
  command: ControlCommand;
  request_id: uint64;
}

table ControlResponse {
  request_id: uint64;
  success: bool;
  message: string;
  peers: [PeerInfo];          // for LIST_PEERS response
  // Local status fields
  local_node_id: [ubyte];
  local_hostname: string;
  local_free_ram: uint64;
  local_free_vram: uint64;
  pool_joined: bool;
  peer_count: uint32;
  // GET_MEMORY_STATS response: memoryd's slab pool, in bytes.
  pool_total_bytes: uint64;
  pool_used_bytes: uint64;
  pool_free_bytes: uint64;
}

root_type ControlRequest;
